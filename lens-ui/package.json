{
  "name": "prism",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "reuse": "node tools/reuse/cli.mjs",
    "reuse:index": "node tools/reuse/cli.mjs index",
    "reuse:search": "node tools/reuse/cli.mjs search",
    "reuse:check": "node tools/reuse/cli.mjs check",
    "reuse:map": "node tools/reuse/cli.mjs map",
    "reuse:test": "node --test tools/reuse/*.test.mjs",
    "reuse:test-model": "node --test tools/reuse/semantic.smoke.mjs",
    "dev": "concurrently \"tsx watch server/server.js\" \"vite --host\" \"npm run backend\"",
    "dev:web": "concurrently \"tsx watch server/server.js\" \"vite --host\"",
    "backend": "bash scripts/run-backend.sh",
    "build": "vite build",
    "start": "tsx server/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "update-model-metadata": "node tools/update-model-catalog-metadata.mjs",
    "reuse:review": "node tools/reuse/cli.mjs review",
    "docs:dev": "cd docs/fern && fern docs dev",
    "docs:check": "cd docs/fern && fern check",
    "docs:api": "python scripts/export-openapi.py",
    "check:english": "node tools/check-english.mjs",
    "test:english": "node --test tools/check-english.test.mjs",
    "check:stack": "node tools/check-llm-d-stack.mjs",
    "test:stack": "node --test tools/check-llm-d-stack.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.1.17",
    "clsx": "^2.1.1",
    "compression": "^1.7.4",
    "echarts": "^6.1.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.554.0",
    "opencc-js": "^1.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.4.1",
    "remark-gfm": "^4.0.1",
    "shell-quote": "^1.8.3",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.19.0",
    "undici": "^6.28.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/shell-quote": "^1.7.5",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fern-api": "^5.129.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
}
