{
  "id": "nvidia",
  "display_name": "NVIDIA GPU",
  "vendor": "nvidia",
  "accelerator_keys": ["cuda", "nvidia", "nvidia_gpu"],
  "benchmark_profile": "nvidia",
  "upstream_variant": "gpu",
  "upstream_vendor": "nvidia",
  "request_model": "extended-resource",
  "device_classes": ["gpu.nvidia.com"],
  "resource_prefixes": ["nvidia.com/gpu"],
  "monitor_resource_suffixes": [],
  "node_label_selector": { "feature.node.kubernetes.io/pci-10de.present": "true" },
  "dranet_device_class": null,
  "access_modes": ["plugin", "dra"],
  "driver": {
    "installer": "helm",
    "modes": {
      "plugin": {
        "manifest_ref": "nvidia-device-plugin",
        "chart_version": "0.17.4",
        "repo": "https://nvidia.github.io/k8s-device-plugin",
        "daemonset_matchers": [
          { "name_contains": "nvidia-device-plugin" },
          { "label": "app.kubernetes.io/name=nvidia-device-plugin" }
        ],
        "options": {
          "nfd_enabled": true,
          "gfd_enabled": true,
          "runtime_class_name": "nvidia"
        }
      },
      "dra": {
        "manifest_ref": "nvidia-dra-driver-gpu",
        "chart_version": "25.8.0",
        "repo": "https://helm.ngc.nvidia.com/nvidia",
        "min_kubernetes_version": "1.32.0",
        "daemonset_matchers": [
          { "name_contains": "nvidia-dra-driver" },
          { "namespace": "nvidia-dra-driver-gpu" }
        ]
      }
    }
  },
  "presence": {
    "node_label_selector": { "feature.node.kubernetes.io/pci-10de.present": "true" },
    "ensure_refs": [],
    "timeout_seconds": 90,
    "poll_interval_seconds": 5
  },
  "telemetry": {
    "provider_id": "nvidia_gpu",
    "device_metrics": {
      "utilization": "DCGM_FI_DEV_GPU_UTIL",
      "framebuffer_used": "1024 * 1024 * DCGM_FI_DEV_FB_USED",
      "vram": "1024 * 1024 * (DCGM_FI_DEV_FB_FREE + DCGM_FI_DEV_FB_USED)",
      "memory_bandwidth_utilization": "DCGM_FI_PROF_DRAM_ACTIVE"
    },
    "device_metric_sources": {
      "utilization": { "metric": "DCGM_FI_DEV_GPU_UTIL", "unit": "percent" },
      "framebuffer_used": { "metric": "DCGM_FI_DEV_FB_USED", "unit": "bytes", "scale": 1048576 },
      "memory_bandwidth_utilization": { "metric": "DCGM_FI_PROF_DRAM_ACTIVE", "unit": "ratio", "scale": 100 }
    },
    "label_schema": { "node": "Hostname", "device": "gpu", "uuid": "UUID" },
    "allocation_join": "none",
    "pod_metrics": {
      "gpu_cache_usage": "vllm:gpu_cache_usage_perc",
      "gpu_memory_usage": "vllm:gpu_memory_usage_bytes"
    },
    "scrape_path": null
  },
  "deployment": {
    "overlay_root": "guides/{guide}/modelserver/{variant}/vllm",
    "arch": "gpu",
    "device_class": "gpu.nvidia.com",
    "claim_request_name": "nvidia",
    "node_selector": { "feature.node.kubernetes.io/pci-10de.present": "true" },
    "resource_name": "nvidia.com/gpu",
    "supports_pci_allowlist": false,
    "runtime_image": "ghcr.io/llm-d/llm-d-cuda:v0.9.0"
  },
  "evaluation_profile": "nvidia",
  "planning": {
    "aic_system_patterns": ["h100|h200|b200|gb200|a100|l40|l4|nvidia"],
    "default_backend": "vllm",
    "device_class_allow_pattern": "^(gpu\\.nvidia\\.com|nvidia\\.com)"
  },
  "ui": { "icon": "Gpu", "labels": { "vendor": "NVIDIA", "metric_group": "GPU" } }
}
