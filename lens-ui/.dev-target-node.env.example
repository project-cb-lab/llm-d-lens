# Copy this file to .dev-target-node.env. To switch machines later, change only
# TARGET_NODE (and LLM_D_ROOT/KUBECONFIG when the cluster or checkout changes).
TARGET_NODE="smc-18"
KUBECONFIG="$HOME/.kube/config"
LLM_D_ROOT="/path/to/llm-d"

# Optional. Leave empty to discover all gpu.intel.com DRA devices on TARGET_NODE.
PRISM_GPU_PCI_ALLOWLIST=""

LLM_D_BENCH_NAMESPACE_PREFIX="llm-d-bench-"
LLM_D_BENCH_READINESS_TIMEOUT_SECONDS="900"
LLM_D_BENCH_KUBECTL_TIMEOUT_SECONDS="120"
LLM_D_BENCH_RETAIN_NAMESPACE_ON_FAILURE="true"

# Optional executable overrides. When empty, the launcher discovers them from PATH.
# LLM_D_BENCH_HELM_PATH="/path/to/helm"
# LLM_D_BENCH_DOCKER_PATH="/path/to/docker"

# Local Prism ports.
FRONTEND_PORT="5173"
SERVER_PORT="3000"
BACKEND_PORT="8081"