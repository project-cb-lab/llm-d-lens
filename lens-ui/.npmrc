registry=https://registry.npmjs.org/
# onnxruntime-node (a transitive dep of @huggingface/transformers, only used by
# its Node.js binding -- the browser build via transformers.js/onnxruntime-web
# never touches it) has a postinstall script that downloads a prebuilt native
# binary from an external CDN. On networks without outbound internet access
# (offline/firewalled deployment hosts) that download hangs and fails `npm
# install` entirely with ETIMEDOUT. Skip install-time lifecycle scripts for
# every `npm install` invocation against this project -- regardless of which
# wrapper script calls it -- so that failure can't block a deploy.
ignore-scripts=true
